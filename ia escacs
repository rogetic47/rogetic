<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grandmaster AI - L'Assistent d'Escacs | Roger Márquez Sabaté</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>

    <style>
        :root {
            --bg-dark: #0a0806;
            --bg-card: #16120e;
            --bg-card-hover: #201a14;
            --accent-gold: #d4af37;
            --accent-gold-light: #f3e5ab;
            --accent-gold-dark: #997a15;
            --border-wood: #3a2a1d;
            --text-main: #f3f0e8;
            --text-muted: #a69a8e;
            --chat-user-bg: #2d2015;
            --chat-ai-bg: #1a1612;
            --sidebar-width: 320px;
            --sq-light: #f0d9b5;
            --sq-dark: #b58863;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--bg-dark); color: var(--text-main); height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

        header { background: rgba(22, 18, 14, 0.95); border-bottom: 1px solid var(--border-wood); padding: 0.8rem 1.8rem; display: flex; justify-content: space-between; align-items: center; z-index: 100; }
        .brand-logo { display: flex; align-items: center; gap: 12px; font-family: 'Cinzel', serif; font-size: 1.4rem; font-weight: 700; color: var(--accent-gold); text-decoration: none; }
        .author-badge { display: flex; align-items: center; gap: 12px; font-size: 0.85rem; color: var(--text-muted); background: rgba(0, 0, 0, 0.3); padding: 6px 14px; border-radius: 30px; border: 1px solid var(--border-wood); }
        .author-badge a { color: var(--accent-gold); text-decoration: none; display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 4px; background: rgba(212, 175, 55, 0.1); }

        .app-container { display: flex; flex: 1; height: calc(100vh - 65px); overflow: hidden; }
        .sidebar { width: var(--sidebar-width); background: var(--bg-card); border-right: 1px solid var(--border-wood); display: flex; flex-direction: column; padding: 1.2rem; gap: 1.2rem; overflow-y: auto; }
        .section-title { font-family: 'Cinzel', serif; font-size: 0.9rem; color: var(--accent-gold); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 8px; }

        .topic-btn { width: 100%; background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-wood); border-radius: 8px; padding: 0.75rem 0.9rem; color: var(--text-main); text-align: left; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; gap: 10px; margin-bottom: 0.5rem; }
        .topic-btn i { color: var(--accent-gold); font-size: 1rem; width: 18px; text-align: center; }

        .chat-container { flex: 1; display: flex; flex-direction: column; background: rgba(10, 8, 6, 0.7); }
        .chat-messages { flex: 1; padding: 1.8rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.2rem; }
        .message { display: flex; gap: 14px; max-width: 88%; }
        .message.user { align-self: flex-end; flex-direction: row-reverse; }
        .avatar { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; border: 1px solid var(--border-wood); }
        .user .avatar { background: var(--accent-gold-dark); color: #fff; }
        .ai .avatar { background: var(--bg-card); color: var(--accent-gold); border-color: var(--accent-gold); }

        .msg-content { background: var(--chat-ai-bg); border: 1px solid var(--border-wood); border-radius: 12px; padding: 1rem 1.2rem; font-size: 0.95rem; line-height: 1.6; color: var(--text-main); }
        .user .msg-content { background: var(--chat-user-bg); border-color: rgba(212, 175, 55, 0.3); }

        .chess-card-embed { background: var(--bg-card); border: 1px solid var(--accent-gold); border-radius: 10px; padding: 1rem; margin: 1rem 0; display: flex; flex-direction: column; gap: 10px; }
        .pgn-box { font-family: 'Courier New', monospace; background: #0d0a08; padding: 10px; border-radius: 6px; border: 1px solid var(--border-wood); font-size: 0.85rem; color: var(--accent-gold-light); white-space: pre-wrap; }
        .resource-link { display: inline-flex; align-items: center; gap: 8px; background: rgba(212, 175, 55, 0.15); color: var(--accent-gold-light); padding: 8px 14px; border-radius: 6px; text-decoration: none; font-size: 0.88rem; border: 1px solid var(--accent-gold); }

        .chat-input-area { padding: 1.2rem 1.8rem; background: var(--bg-card); border-top: 1px solid var(--border-wood); display: flex; gap: 12px; align-items: center; }
        .chat-input-area textarea { flex: 1; background: var(--bg-dark); border: 1px solid var(--border-wood); border-radius: 8px; padding: 12px 16px; color: var(--text-main); font-family: inherit; font-size: 0.95rem; resize: none; height: 48px; outline: none; }
        .send-btn { background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dark)); color: #000; border: none; border-radius: 8px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1.1rem; }

        .interactive-panel { width: 380px; background: var(--bg-card); border-left: 1px solid var(--border-wood); padding: 1.2rem; display: flex; flex-direction: column; gap: 1rem; align-items: center; }

        .board-wrapper { width: 100%; max-width: 330px; aspect-ratio: 1; border: 3px solid var(--accent-gold); border-radius: 8px; overflow: hidden; display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr); box-shadow: 0 10px 30px rgba(0,0,0,0.8); }
        .sq { display: flex; align-items: center; justify-content: center; font-size: 2.2rem; cursor: pointer; user-select: none; line-height: 1; }
        .sq.light { background-color: var(--sq-light); color: #1a120b; }
        .sq.dark { background-color: var(--sq-dark); color: #1a120b; }
        .sq.selected { background-color: rgba(255, 235, 59, 0.7) !important; }

        .board-controls { display: flex; gap: 8px; width: 100%; }
        .btn-board { flex: 1; background: rgba(0,0,0,0.4); border: 1px solid var(--border-wood); color: var(--text-main); padding: 8px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .fen-box { width: 100%; background: var(--bg-dark); border: 1px solid var(--border-wood); border-radius: 6px; padding: 8px 10px; font-family: monospace; font-size: 0.75rem; color: var(--text-muted); word-break: break-all; }
    </style>
</head>
<body>

    <header>
        <a href="#" class="brand-logo"><i class="fa-solid fa-chess-knight"></i><span>Grandmaster AI</span></a>
        <div class="author-badge">
            <span>Desenvolupat per <strong>Roger Márquez Sabaté</strong></span>
            <a href="https://ratings.fide.com/profile/94769117" target="_blank" rel="noopener"><i class="fa-solid fa-trophy"></i> FIDE</a>
            <a href="https://www.escacs.cat/" target="_blank" rel="noopener"><i class="fa-solid fa-chess-pawn"></i> escacs.cat</a>
        </div>
    </header>

    <div class="app-container">
        <aside class="sidebar">
            <div>
                <div class="section-title"><i class="fa-solid fa-book-open"></i> Temes d'Escacs</div>
                <button class="topic-btn" onclick="sendPrompt('Explica la Defensa Siciliana i la variant Najdorf')"><i class="fa-solid fa-chess-board"></i> Defenses i Obertures</button>
                <button class="topic-btn" onclick="sendPrompt('Explica la posició de Lucena i finals de torres')"><i class="fa-solid fa-crown"></i> Finals Tàctics</button>
                <button class="topic-btn" onclick="sendPrompt('Què és el Zugzwang?')"><i class="fa-solid fa-skull-crossbones"></i> Zugzwang</button>
                <button class="topic-btn" onclick="sendPrompt('Explica el Gambit de Dama amb el seu PGN d\'exemple')"><i class="fa-solid fa-chess-queen"></i> Gambit de Dama</button>
            </div>

            <div style="margin-top: auto; padding: 10px; background: rgba(212,175,55,0.05); border: 1px solid var(--border-wood); border-radius: 8px; font-size: 0.8rem; color: var(--text-muted);">
                <i class="fa-solid fa-bolt" style="color:var(--accent-gold);"></i> <strong>IA Online Activada:</strong> Connectat directament al servidor de model de llenguatge d'escacs.
            </div>
        </aside>

        <main class="chat-container">
            <div class="chat-messages" id="chatMessages">
                <div class="message ai">
                    <div class="avatar"><i class="fa-solid fa-robot"></i></div>
                    <div class="msg-content">
                        <p><strong>Hola! Sóc la teva IA de Gran Mestre d'Escacs.</strong> ♟️</p>
                        <p>Pregunta'm qualsevol cosa (obertures, PGNs, finals o estratègia) i et respondré en temps real!</p>
                    </div>
                </div>
            </div>

            <div class="chat-input-area">
                <textarea id="userInput" placeholder="Pregunta el que vulguis (ex: gambito de dama pgn, variant najdorf, regla del quadrat...)" onkeydown="handleKeyDown(event)"></textarea>
                <button class="send-btn" onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </main>

        <aside class="interactive-panel">
            <div class="section-title"><i class="fa-solid fa-chess-board"></i> Tauler d'Anàlisi</div>
            <div class="board-wrapper" id="board"></div>
            <div class="board-controls">
                <button class="btn-board" onclick="resetBoard()"><i class="fa-solid fa-rotate-left"></i> Posició Inicial</button>
                <button class="btn-board" onclick="flipBoard()"><i class="fa-solid fa-repeat"></i> Gira Tauler</button>
            </div>
            <div style="width:100%">
                <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:4px;">FEN Actual:</div>
                <div class="fen-box" id="fenDisplay">rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1</div>
            </div>
        </aside>
    </div>

    <script>
        const SYMBOLS = {
            'p': '♟', 'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚',
            'P': '♙', 'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔'
        };

        let game = new Chess();
        let flipped = false;
        let selectedSquare = null;

        function renderBoard() {
            const boardEl = document.getElementById('board');
            boardEl.innerHTML = '';
            const boardState = game.board();

            for (let r = 0; r < 8; r++) {
                for (let c = 0; c < 8; c++) {
                    const row = flipped ? 7 - r : r;
                    const col = flipped ? 7 - c : c;
                    const squareName = String.fromCharCode(97 + col) + (8 - row);
                    const piece = boardState[row][col];

                    const sq = document.createElement('div');
                    sq.className = `sq ${(row + col) % 2 === 0 ? 'light' : 'dark'}`;
                    if (selectedSquare === squareName) sq.classList.add('selected');

                    if (piece) {
                        const key = piece.color === 'w' ? piece.type.toUpperCase() : piece.type;
                        sq.textContent = SYMBOLS[key];
                    }

                    sq.onclick = () => handleSquareClick(squareName);
                    boardEl.appendChild(sq);
                }
            }
            document.getElementById('fenDisplay').textContent = game.fen();
        }

        function handleSquareClick(sq) {
            if (selectedSquare) {
                const move = game.move({ from: selectedSquare, to: sq, promotion: 'q' });
                selectedSquare = null;
                if (move) { renderBoard(); return; }
            }
            const piece = game.get(sq);
            if (piece && piece.color === game.turn()) { selectedSquare = sq; } 
            else { selectedSquare = null; }
            renderBoard();
        }

        function resetBoard() { game.reset(); selectedSquare = null; renderBoard(); }
        function flipBoard() { flipped = !flipped; renderBoard(); }
        function loadFenToBoard(fen) { if (game.load(fen)) { selectedSquare = null; renderBoard(); } }

        window.onload = () => { renderBoard(); };

        function handleKeyDown(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }
        function sendPrompt(text) { document.getElementById('userInput').value = text; sendMessage(); }

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const text = input.value.trim();
            if (!text) return;

            appendMessage('user', text);
            input.value = '';

            const loadingId = appendLoadingMessage();
            
            // Actualitza el tauler segons la pregunta de l'usuari
            updateBoardBasedOnText(text);

            // Petició a la IA real gratuïta d'accés lliure
            let responseText = await fetchFreeAIResponse(text);

            removeLoadingMessage(loadingId);
            appendMessage('ai', responseText);
        }

        function updateBoardBasedOnText(p) {
            const prompt = p.toLowerCase();
            if (prompt.includes('gambito') || prompt.includes('gambit') || prompt.includes('dama')) {
                loadFenToBoard('rnbqkbnr/ppp1pppp/8/3p4/2PP4/8/PP2PPPP/RNBQKBNR b KQkq c3 0 2');
            } else if (prompt.includes('siciliana') || prompt.includes('najdorf')) {
                loadFenToBoard('rnbqk2r/pp2bppp/3p1n2/4p3/3NP3/2N5/PPP1BPPP/R1BQ1RK1 w kq - 0 1');
            } else if (prompt.includes('zugzwang')) {
                loadFenToBoard('8/8/8/4k3/8/4K3/4P3/8 w - - 0 1');
            } else if (prompt.includes('lucena')) {
                loadFenToBoard('1R6/8/8/3k4/8/8/1p6/1K6 w - - 0 1');
            }
        }

        function appendMessage(sender, content) {
            const chatMessages = document.getElementById('chatMessages');
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${sender}`;
            const avatarIcon = sender === 'user' ? 'fa-user' : 'fa-robot';
            msgDiv.innerHTML = `<div class="avatar"><i class="fa-solid ${avatarIcon}"></i></div><div class="msg-content">${content}</div>`;
            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function appendLoadingMessage() {
            const id = 'loading-' + Date.now();
            const chatMessages = document.getElementById('chatMessages');
            const msgDiv = document.createElement('div');
            msgDiv.className = 'message ai';
            msgDiv.id = id;
            msgDiv.innerHTML = `<div class="avatar"><i class="fa-solid fa-robot"></i></div><div class="msg-content"><em>L'IA de Gran Mestre està pensant la resposta... ♟️</em></div>`;
            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return id;
        }

        function removeLoadingMessage(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        // Connexió amb la IA lliure (Pollinations AI / OpenAI Proxy)
        async function fetchFreeAIResponse(userPrompt) {
            try {
                const systemPrompt = "Ets un Gran Mestre d'Escacs i assistent virtual creat per Roger Márquez Sabaté. Respon en català de forma clara, directa i experta. Si et demanen PGNs o variants d'obertura, inclou-los sempre en format text clar.";
                
                const response = await fetch('https://text.pollinations.ai/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        messages: [
                            { role: 'system', content: systemPrompt },
                            { role: 'user', content: userPrompt }
                        ],
                        model: 'openai'
                    })
                });

                if (!response.ok) throw new Error("Error en el servidor de la IA");

                let data = await response.text();
                
                // Formatar text amb paràgrafs HTML si ve en text pla
                data = data.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');
                return `<p>${data}</p>`;
            } catch (err) {
                // Resposta de seguretat en cas que falli la connexió de xarxa
                return `
                    <p><strong>Gambit de Dama:</strong> És una obertura d'escacs que comença amb 1.d4 d5 2.c4.</p>
                    <div class="chess-card-embed">
                        <div class="pgn-box">[Event "Gambit de Dama"]\n1. d4 d5 2. c4 e6 3. Nc3 Nf6 4. Bg5 Be7</div>
                    </div>
                `;
            }
        }
    </script>
</body>
</html>
